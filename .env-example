# Maxiter environment example file.
# Keep the same logical sections from env.ini using the pattern:
# section__KEY="value"

# [app]
app__APP_NAME="Maxiter"
app__APP_DESCRIPTION="A way fast PHP project builder"
app__BEARER_TOKEN="Bearer your-token-here"

# [timezone]
timezone__DEFAULT_TIMEZONE="America/Sao_Paulo"

# [maxiter]
maxiter__DB="maxiter"
maxiter__DRIVER="mysql"
maxiter__PORT="3306"
maxiter__HOST="localhost"
maxiter__USER="root"
maxiter__PASS=""
